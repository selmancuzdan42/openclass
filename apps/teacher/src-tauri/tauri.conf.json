{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenClass Teacher",
  "mainBinaryName": "OpenClass-Teacher",
  "version": "0.2.0",
  "identifier": "io.openclass.teacher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenClass Öğretmen",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ocframe: http://ocframe.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "OpenClass",
    "copyright": "GPL-3.0-or-later",
    "category": "Education",
    "shortDescription": "Sınıf yönetimi — öğretmen konsolu",
    "longDescription": "OpenClass Teacher, yerel ağdaki öğrenci bilgisayarlarını keşfeder, güvenli biçimde eşleştirir ve ders oturumu boyunca ekranlarını canlı izlemeyi sağlar.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Turkish",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "perMachine"
      },
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    }
  }
}
