{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Öğrenci ajanının yapılandırma ve mesaj pencerelerine verilen izinler.",
  "windows": [
    "main",
    "notice",
    "broadcast",
    "activity",
    "lock"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "opener:default"
  ]
}
